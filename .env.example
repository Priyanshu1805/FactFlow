# ==============================================================================
# FACT FLOW ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & SERVER CONFIGURATION (Required)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/factflow
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/factflow
MONGODB_URI=mongodb://127.0.0.1:27017/factflow

# JWT Security Secrets (Used for token signing)
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Frontend & Backend URL configurations
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION (Required for Google Login & Password Auth)
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Required for Profile Picture & Story/Reel media uploads)
# Get these from https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. YOUTUBE API (Optional - For syncing YouTube Shorts & Live TV channels)
# Get from Google Cloud Console -> APIs & Services -> YouTube Data API v3
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 5. AI SERVICES (Optional - For AI News Summarization & Classifiers)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 6. PAYMENTS (Optional - For Premium Subscriptions)
# Cashfree or Paytm credentials
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFICATIONS (Optional - For newsletter & digest emails)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
